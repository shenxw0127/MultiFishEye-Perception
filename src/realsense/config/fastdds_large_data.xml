<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fast DDS 大数据传输配置 —— 640x480 图像与彩色点云跑满 30Hz 的必要条件。

  为什么需要它
  ============
  Fast DDS（Humble 默认 RMW）的共享内存传输默认段大小只有 512KB。本相机的单帧大小：
      infra1 mono8 640x480 = 307KB   -> 小于 512KB，默认配置就能满 30Hz
      depth  Z16   640x480 = 614KB   -> 超了
      color  rgb8  640x480 = 922KB   -> 超了
      点云   XYZRGB(32B/点)          -> 最大 9.8MB，远超
  超过段大小的样本会退回 UDP 分片（922KB 要切成 ~660 个数据报），而内核
  net.core.rmem_max 默认只有 208KB，连一帧都放不下，于是大量分片被丢弃。
  丢一片就废掉整帧，实测帧率从 30Hz 掉到 5Hz 左右。

  实测对比（D435i, 640x480x30）：
      话题                默认配置    本配置
      color/image_raw      5.3Hz     29.98Hz
      depth/image_rect_raw 5.2Hz     29.98Hz
      depth/color/points   4.2Hz     29.98Hz
      infra1/image_rect    30.0Hz    29.98Hz   （本来就没超 512KB）

  用法
  ====
  d435i.launch.py 默认已通过 FASTRTPS_DEFAULT_PROFILES_FILE 把本文件加载给相机进程，
  不需要任何额外操作。共享内存段由写端创建、读端只做映射，所以只配发布端就够了：
  实测订阅端（另一个终端里的 ros2 topic hz，没有该环境变量）同样拿到 29.97Hz。
  rviz2 / foxglove / 其它节点直接订阅即可。

  如果外部已经 export 过 FASTRTPS_DEFAULT_PROFILES_FILE，launch 不会覆盖它——
  那种情况下请自行确认该 profile 的 SHM 段足够大。

  跨机器传输
  ==========
  共享内存只在同一台机器生效。要跨网络跑满 30Hz，还得放开内核 UDP 缓冲：
      sudo sysctl -w net.core.rmem_max=16777216
      sudo sysctl -w net.core.wmem_max=16777216
  （持久化就写进 /etc/sysctl.d/。）或者干脆降分辨率 / 订阅 image_raw/compressed。
-->
<dds xmlns="http://www.eprosima.com">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>shm_large</transport_id>
        <type>SHM</type>
        <!-- 128MB：够放下十几帧最大的点云，留足抖动余量 -->
        <segment_size>134217728</segment_size>
        <!-- 单条消息上限 16MB，覆盖 9.8MB 的满分辨率有序点云 -->
        <maxMessageSize>16777216</maxMessageSize>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>udp_remote</transport_id>
        <type>UDPv4</type>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="realsense_large_data" is_default_profile="true">
      <rtps>
        <!-- 顺序即优先级：同机走 SHM，跨机回落 UDPv4 -->
        <userTransports>
          <transport_id>shm_large</transport_id>
          <transport_id>udp_remote</transport_id>
        </userTransports>
        <!-- 关掉内置传输，否则默认的 512KB SHM 描述符仍会被用上 -->
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
