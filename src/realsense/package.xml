<?xml version="1.0"?>
<package format="3">
  <name>realsense_ros2</name>
  <version>1.1.0</version>
  <description>
    RealSense D435i / D405 launch 包（D405 见 d405.launch.py：官方 ASIC 深度 + librealsense 后处理）；D435i：30Hz 实时发布彩色点云 (XYZRGB) + RGB 图像，
    并附带全局快门的左红外图；以及服务触发的定时录制（RGB / 深度 / 左右红外 / IMU / 外参）。
    相机节点复用官方 realsense2_camera 组件，本包只编译录制组件。
  </description>

  <maintainer email="shenxuewen0127@gmail.com">shenxw</maintainer>

  <license>MIT</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <!-- 录制组件（src/recorder）：Record 服务复用 oak_interfaces -->
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_storage</depend>
  <depend>oak_interfaces</depend>

  <!-- 相机节点用官方组件；录制的 extrinsics / tf_static 类型在写 bag schema 时需要 -->
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>realsense2_camera_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <!-- recorder.launch.py 与 d435i.launch.py 的 foxglove:=true 都依赖 foxglove 桥 -->
  <exec_depend>foxglove_bridge</exec_depend>
  <!-- mcap 存储插件 -->
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <!-- record_all.launch.py：include oak.launch.py，record_all.py 协调节点用 rclpy -->
  <exec_depend>oak_ros2</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>vrpn_mocap</exec_depend>
  <!-- launch 里用 get_package_share_directory 定位 config/fastdds_large_data.xml -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>builtin_interfaces</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
