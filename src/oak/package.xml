<?xml version="1.0"?>
<package format="3">
  <name>oak_ros2</name>
  <version>1.0.0</version>
  <description>ROS2 component for synchronized OAK FFC camera images and IMU data.</description>

  <maintainer email="adam.serafin@luxonis.com">Adam Serafin</maintainer>
  <author>Sachin Guruswamy</author>

  <license>MIT</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>depthai</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>OpenCV</depend>
  <depend>cv_bridge</depend>
  <depend>yaml-cpp</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
